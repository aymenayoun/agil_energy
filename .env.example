# ==========================================
# AGIL Energy — Environment Variables Template
# Copy this file to .env and fill in real values
# ==========================================

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agil_energy
DB_USER=
DB_PASSWORD=

# --- JWT ---
# 24 hours in milliseconds
JWT_EXPIRATION=86400000
# 7 days in milliseconds
JWT_REFRESH_EXPIRATION=604800000
# Base64-encoded secret, at least 256 bits (32 bytes) — generate a new one per environment
JWT_SECRET=

# --- Python IA Microservice ---
IA_SERVICE_URL=http://localhost:5000
IA_API_KEY=

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-app-account@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=your-app-account@gmail.com
MAIL_FROM_NAME=AGIL Energy

# --- 2FA OTP ---
OTP_ENABLED=true
OTP_EXPIRATION_MINUTES=5
# Apply 2FA to which roles (comma-separated): ADMIN, MANAGER, STATION_MANAGER, or "ALL"
OTP_REQUIRED_ROLES=ADMIN

# --- Alert email notifications ---
ALERT_EMAIL_ENABLED=true
# Optional override: comma-separated extra emails. If empty, defaults to all ADMIN users.
ALERT_EMAIL_RECIPIENTS=